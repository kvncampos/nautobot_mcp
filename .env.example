# Nautobot MCP Server Configuration
# Copy this file to .env and update the values as needed

# Environment Configuration - Change this ONE setting to switch environments
# Available options: "local", "nonprod", "prod"
NAUTOBOT_ENV=local

# Environment-specific credentials (only needed if overriding creds_helper defaults)
# For LOCAL environment:
# NAUTOBOT_LOCAL_TOKEN=your_local_token_here

# For NONPROD environment:
# NAUTOBOT_NONPROD_BASE_URL=https://your-nonprod-nautobot.com/
# NAUTOBOT_NONPROD_TOKEN=your_nonprod_token_here

# For PROD environment:
# NAUTOBOT_PROD_BASE_URL=https://your-prod-nautobot.com/
# NAUTOBOT_PROD_TOKEN=your_prod_token_here

# Server Configuration
API_PREFIX=nautobot_openapi
SERVER_NAME=any_openapi
SERVER_VERSION=0.2.0
NAUTOBOT_TOKEN=""
GITHUB_TOKEN=""

SSL_VERIFY=False

# Logging
LOG_LEVEL=INFO

# ChromaDB Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
DEFAULT_SEARCH_RESULTS=5
TOKENIZERS_PARALLELISM=false

# External Services
POSTHOG_API_KEY=disable

# Request Configuration
API_TIMEOUT=10

# ──────────────────────────────────────────────────────────────────────────────
# Nautobot Direct-DB MCP Server (server_db.py)
# ──────────────────────────────────────────────────────────────────────────────

# SECURITY NOTE: Create a dedicated PostgreSQL read-only user for the DB MCP:
#   CREATE ROLE nautobot_readonly LOGIN PASSWORD 'changeme';
#   GRANT CONNECT ON DATABASE nautobot TO nautobot_readonly;
#   GRANT USAGE ON SCHEMA public TO nautobot_readonly;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO nautobot_readonly;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO nautobot_readonly;

# DB credentials per environment (mirrors existing NAUTOBOT_*_TOKEN naming)
# LOCAL
NAUTOBOT_LOCAL_DB_HOST=localhost
NAUTOBOT_LOCAL_DB_PORT=5432
NAUTOBOT_LOCAL_DB_NAME=nautobot
NAUTOBOT_LOCAL_DB_USER=nautobot_readonly
NAUTOBOT_LOCAL_DB_PASSWORD=

# NONPROD
# NAUTOBOT_NONPROD_DB_HOST=
# NAUTOBOT_NONPROD_DB_PORT=5432
# NAUTOBOT_NONPROD_DB_NAME=nautobot
# NAUTOBOT_NONPROD_DB_USER=nautobot_readonly
# NAUTOBOT_NONPROD_DB_PASSWORD=

# PROD
# NAUTOBOT_PROD_DB_HOST=
# NAUTOBOT_PROD_DB_PORT=5432
# NAUTOBOT_PROD_DB_NAME=nautobot
# NAUTOBOT_PROD_DB_USER=nautobot_readonly
# NAUTOBOT_PROD_DB_PASSWORD=

# Secret provider: "env" (default) | "vault" (future)
DB_SECRET_PROVIDER=env

# DB RBAC + safety limits
DB_PERMISSION_LEVEL=read_only
DB_MAX_ROWS=500
DB_QUERY_TIMEOUT=30
# DB_ALLOWED_TABLES=          # Leave empty = all non-denied tables
DB_DENIED_TABLES=users_user,authtoken_token,django_session,social_auth_usersocialauth,django_admin_log

# Redis (uses Nautobot's built-in Redis, DB index 1 to avoid collisions)
NAUTOBOT_REDIS_HOST=localhost
NAUTOBOT_REDIS_PORT=6379
NAUTOBOT_REDIS_DB=1
# NAUTOBOT_REDIS_PASSWORD=

# Schema embedding sync
DB_SCHEMA_SYNC_INTERVAL_HOURS=6
DB_SCHEMA_HASH_KEY=nautobot_db_mcp:schema_hash

# Response format: "toon" (~40% token reduction, default) | "json"
DB_RESPONSE_FORMAT=toon

# DB MCP server port (separate from server_http.py on 8000)
DB_MCP_PORT=8001
